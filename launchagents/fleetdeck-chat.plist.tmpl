<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>__PREFIX__.fleetdeck-chat</string>
	<!-- Exec'd directly so the shebang (/usr/bin/python3, a path brew cannot
	     move) is the job binary. This server spawns and supervises its own
	     loopback ttyd child - there is deliberately no second LaunchAgent, so
	     the terminal backend cannot outlive or drift from the UI serving it. -->
	<key>ProgramArguments</key>
	<array>
		<string>__ROOT__/chat_server.py</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>__HOME__/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>PORT</key>
		<string>__CHAT_PORT__</string>
		<key>TTYD_PORT</key>
		<string>__TTYD_PORT__</string>
		<!-- "tailscale" resolves the 100.x address at boot and DEGRADES CLOSED to
		     loopback if Tailscale is down. That bind is the only thing between
		     the tailnet and a writable shell, so it must never fall open. -->
		<!-- Loopback, with `tailscale serve` in front on the chat port, rather
		     than binding the tailnet address directly.

		     Upstream binds the tailnet IP here so that the socket itself is the
		     boundary. That works, but it leaves the surface on plain http, and a
		     plain-http origin is not a secure context: Add to Home Screen degrades
		     on the one tile most worth installing, and iPhone Safari's
		     https-upgrade can fail the load outright. LIVE-9 asserts exactly this
		     and fails against a tailnet-bound chat.

		     Fronting it does not widen access. A tailnet peer reaches the chat
		     either way; a local process could already dial the tailnet IP as
		     easily as loopback. And it still fails CLOSED — with Tailscale down
		     the bind is loopback-only and the front simply stops answering, which
		     is the property that matters for a writable shell. -->
		<key>BIND</key>
		<string>127.0.0.1</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/tmp/fleetdeck-chat.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/fleetdeck-chat.log</string>
</dict>
</plist>
