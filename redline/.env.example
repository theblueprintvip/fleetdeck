# Twilio — SMS/MMS webhook at /api/sms
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_NUMBER=+15555550123

# SendGrid — Inbound Parse webhook at /api/email?key=$INBOUND_PARSE_KEY
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM=scan@redline.app
INBOUND_PARSE_KEY=long_random_string

# Public origin used in result links (no trailing slash)
PUBLIC_URL=https://redline.app
